# Stage 1: Build the Vue application
FROM oven/bun:1.4-alpine AS builder
WORKDIR /app

# Copy package.json and Bun's lockfile (if you have generated one locally)
COPY package.json bun.lock* ./

# Install dependencies using Bun
RUN bun install

COPY . .

# Build the project using Bun
RUN bun run build

# Stage 2: Serve with Nginx and proxy to Go
FROM nginx:1.31-alpine

# Install timezone data
RUN apk add --no-cache tzdata

# Copy the built Vue files to Nginx's default public folder
COPY --from=builder /app/dist /usr/share/nginx/html
# Overwrite the default Nginx config with our custom proxy routing
COPY nginx.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]